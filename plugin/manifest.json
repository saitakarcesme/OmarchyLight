{
  "schemaVersion": 1,
  "id": "omarchylight.menu",
  "name": "OmarchyLight",
  "version": "0.1.0",
  "author": "saitakarcesme / Omarchy contributors",
  "description": "Spotlight-inspired Omarchy launcher with liquid category transitions",
  "kinds": [
    "menu",
    "bar-widget"
  ],
