{
  "name": "OmarchyLight",
  "slug": "omarchylight",
  "kind": "light",
  "dependencies": [
    "quickshell",
    "hyprctl",
    "omarchy",
    "python3",
    "magick",
    "gtk-launch",
    "uwsm-app"
  ],
  "copies": [
    {
      "source": "plugin",
      "destination": ".config/omarchy/plugins/omarchylight.menu"
    }
  ],
  "lua": {
    ".config/hypr/looknfeel.lua": "hl.layer_rule({ match = { namespace = \"^omarchylight$\" }, blur = true, blur_popups = true, ignore_alpha = 0.2, no_anim = true })",
    ".config/hypr/bindings.lua": "hl.unbind(\"SUPER + SPACE\")\no.bind(\"SUPER + SPACE\", \"OmarchyLight\", \"omarchy-menu toggle\")"
  }
}
